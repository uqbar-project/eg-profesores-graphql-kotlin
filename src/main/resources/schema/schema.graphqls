scalar URL

# La materia para el schema GraphQL es una interface, aunque
# se implementa en Kotlin como una clase abstracta
interface Materia {
    nombre: String!
    anio: Int
    codigo: String
    sitioWeb: URL
    cargaHoraSemanal: Int
    # campo calculado (en común)
    cargaTotal: Float
}

# 1. Subclase: MateriaInteresante
type MateriaInteresante implements Materia {
    nombre: String!
    anio: Int
    codigo: String
    sitioWeb: URL
    cargaHoraSemanal: Int
    cargaTotal: Float

    # Campo específico
    gradoDeInteres: Int
}

# 2. Subclase: MateriaDesafiante
type MateriaDesafiante implements Materia {
    nombre: String!
    anio: Int
    codigo: String
    sitioWeb: URL
    cargaHoraSemanal: Int
    cargaTotal: Float

    # Campos específicos
    cargaHorasExtra: Int
    momentoDificil: Boolean
}

# =====================================================================
type Query {
    profesores(nombreFilter: String): [Profesor]
    profesor(idProfesor: Int): Profesor
}

type Profesor {
    id: Int
    nombre: String!
    apellido: String
    anioComienzo: Int
    puntajeDocente: Int
    materias: [Materia]
}

# =====================================================================

type Mutation {
    actualizarProfesor(updateProfesor: UpdateProfesor): Profesor
    agregarMateria(idProfesor: Int, materiaInput: MateriaInput): Profesor
}

input UpdateProfesor {
    id: Int
    nombre: String
    apellido: String
}

input MateriaInput {
    id: Int
    nombre: String
}
